#!/bin/sh

# wt - a small, dependency-free Git worktree manager.

set -u

PROGRAM=${0##*/}

usage() {
    cat <<EOF
Usage:
  $PROGRAM create [--allow-dev-branches] <branch-name>
  $PROGRAM cleanup [--force] <branch-name>
EOF
}

die() {
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit 1
}

git_root() {
    git rev-parse --show-toplevel 2>/dev/null ||
        die "the current directory is not inside a Git worktree"
}

validate_branch_name() {
    [ -n "$1" ] || die "a branch name is required"
    git check-ref-format --branch "$1" >/dev/null 2>&1 ||
        die "invalid branch name: $1"
}

worktrees_root() {
    repo=$1
    repo_parent=${repo%/*}
    repo_name=${repo##*/}
    printf '%s/%s.worktrees\n' "$repo_parent" "$repo_name"
}

# Print the path of the worktree where a local branch is checked out.
worktree_for_branch() {
    wanted_ref="refs/heads/$1"
    found_path=
    current_path=

    while IFS= read -r line; do
        case $line in
            "worktree "*) current_path=${line#worktree } ;;
            "branch "*)
                if [ "${line#branch }" = "$wanted_ref" ]; then
                    found_path=$current_path
                    break
                fi
                ;;
            "") current_path= ;;
        esac
    done <<EOF
$(git worktree list --porcelain)
EOF

    [ -n "$found_path" ] && printf '%s\n' "$found_path"
}

# Return success when Git knows about the exact worktree path.
is_registered_worktree() {
    wanted_path=$1
    while IFS= read -r line; do
        case $line in
            "worktree "*)
                [ "${line#worktree }" = "$wanted_path" ] && return 0
                ;;
        esac
    done <<EOF
$(git worktree list --porcelain)
EOF
    return 1
}

create_worktree() {
    allow_dev_branches=false
    branch=

    while [ "$#" -gt 0 ]; do
        case $1 in
            --allow-dev-branches) allow_dev_branches=true ;;
            -h|--help) usage; exit 0 ;;
            --) shift; [ "$#" -gt 0 ] || die "a branch name is required"; branch=$1; shift; [ "$#" -eq 0 ] || die "too many arguments"; break ;;
            -*) die "unknown option for create: $1" ;;
            *) [ -z "$branch" ] || die "too many arguments"; branch=$1 ;;
        esac
        shift
    done

    [ -n "$branch" ] || die "a branch name is required"
    validate_branch_name "$branch"

    repo=$(git_root) || exit 1
    root=$(worktrees_root "$repo")
    destination=$root/$branch

    existing=$(worktree_for_branch "$branch" || true)
    if [ -n "$existing" ]; then
        printf 'Worktree for branch %s already exists.\n' "$branch" >&2
        printf '%s\n' "$existing"
        return 0
    fi

    current_branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null) ||
        die "the current worktree has a detached HEAD"

    if [ "$allow_dev_branches" = false ] &&
       [ "$current_branch" != main ] &&
       [ "$current_branch" != staging ]; then
        die "worktrees can only be created from main or staging (currently on $current_branch); pass --allow-dev-branches to override"
    fi

    git -C "$repo" rev-parse --verify --quiet 'HEAD^{commit}' >/dev/null ||
        die "repository has no commits yet; create an initial commit before creating a worktree"

    if [ -e "$destination" ]; then
        die "destination already exists but is not a registered worktree: $destination"
    fi

    mkdir -p "${destination%/*}" || die "could not create worktree directory"

    if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
        git -C "$repo" worktree add --quiet "$destination" "$branch" ||
            die "failed to create worktree for existing branch $branch"
    else
        git -C "$repo" worktree add --quiet -b "$branch" "$destination" HEAD ||
            die "failed to create worktree and branch $branch"
    fi

    printf '%s\n' "$destination"
}

has_unpushed_commits() {
    path=$1

    if upstream=$(git -C "$path" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null); then
        [ "$(git -C "$path" rev-list --count "$upstream"..HEAD)" -gt 0 ]
        return
    fi

    if [ -n "$(git -C "$path" for-each-ref --format='%(refname)' refs/remotes)" ]; then
        [ "$(git -C "$path" rev-list --count HEAD --not --remotes)" -gt 0 ]
        return
    fi

    # Repositories without a remote can still safely remove an unchanged
    # worktree. Anything unique to the branch is considered unpushed.
    exclusions=
    for base in main staging; do
        if git -C "$path" show-ref --verify --quiet "refs/heads/$base"; then
            exclusions="$exclusions refs/heads/$base"
        fi
    done

    if [ -z "$exclusions" ]; then
        return 0
    fi

    # Word splitting here is intentional: exclusions contains validated refs.
    # shellcheck disable=SC2086
    [ "$(git -C "$path" rev-list --count HEAD --not $exclusions)" -gt 0 ]
}

cleanup_worktree() {
    force=false
    branch=

    while [ "$#" -gt 0 ]; do
        case $1 in
            --force) force=true ;;
            -h|--help) usage; exit 0 ;;
            --) shift; [ "$#" -gt 0 ] || die "a branch name is required"; branch=$1; shift; [ "$#" -eq 0 ] || die "too many arguments"; break ;;
            -*) die "unknown option for cleanup: $1" ;;
            *) [ -z "$branch" ] || die "too many arguments"; branch=$1 ;;
        esac
        shift
    done

    [ -n "$branch" ] || die "a branch name is required"
    validate_branch_name "$branch"

    repo=$(git_root) || exit 1
    root=$(worktrees_root "$repo")
    destination=$root/$branch

    if [ ! -d "$destination" ]; then
        # The directory may have been removed manually. Prune any stale Git
        # metadata and preserve cleanup's idempotent behavior.
        git -C "$repo" worktree prune >/dev/null 2>&1 || true
        return 0
    fi

    if ! is_registered_worktree "$destination"; then
        return 0
    fi

    if [ "$force" = false ]; then
        if [ -n "$(git -C "$destination" status --porcelain --untracked-files=normal)" ]; then
            die "worktree has uncommitted changes: $destination"
        fi

        if has_unpushed_commits "$destination"; then
            die "branch has unpushed commits: $branch"
        fi
    fi

    if [ "$force" = true ]; then
        git -C "$repo" worktree remove --force --force "$destination" ||
            die "failed to remove worktree: $destination"
    else
        git -C "$repo" worktree remove "$destination" ||
            die "failed to remove worktree: $destination"
    fi

    # Remove empty directories created for branch names such as feature/login.
    parent=${destination%/*}
    while [ "$parent" != "$root" ]; do
        rmdir "$parent" 2>/dev/null || break
        parent=${parent%/*}
    done
}

main() {
    [ "$#" -gt 0 ] || { usage >&2; exit 1; }

    command=$1
    shift
    case $command in
        create) create_worktree "$@" ;;
        cleanup) cleanup_worktree "$@" ;;
        -h|--help|help) usage ;;
        *) die "unknown command: $command" ;;
    esac
}

main "$@"
